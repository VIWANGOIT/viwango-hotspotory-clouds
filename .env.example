# ---------------------------------------------------------------------------
# VIWANGO Hotspot Cloud - copy to .env.local and fill in. Never commit .env*.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Management API values, only needed for `npm run db:migrate` / `db:seed`
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Encrypts router passwords at rest (openssl rand -base64 32)
ROUTER_CREDENTIALS_KEY=

# Protects /api/cron/heartbeat (openssl rand -hex 24)
CRON_SECRET=

# Public base URL of this deployment
APP_URL=http://localhost:3000

# Optional: M-Pesa (Daraja) for self-service voucher sales
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain/api/payments/mpesa/callback
